<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>BASE</title>
  <link rel="stylesheet" href="./styles.css" />

  <!-- Get Started styling (INLINE so no CSS file edits) -->
  <style>
    .cta{
      margin-top: 34px;
      font-size: 14px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(245,242,238,.82);
      text-decoration: none;
      position: relative;
      opacity: 0;
      transform: translateY(10px);
      animation: ctaIn .9s ease forwards;
      animation-delay: 1.8s;
    }

    .cta::after{
      content:"";
      position:absolute;
      left:50%;
      bottom:-8px;
      width:24px;
      height:1px;
      background: rgba(245,242,238,.5);
      transform: translateX(-50%) scaleX(0);
      transition: transform .35s ease;
    }

    .cta:hover::after{
      transform: translateX(-50%) scaleX(1);
    }

    @keyframes ctaIn{
      to{
        opacity:1;
        transform: translateY(0);
      }
    }
  </style>

  <script>
    (function(){
      var ua = navigator.userAgent;
      var isChrome = /Chrome\//.test(ua) && !/Edg\//.test(ua) && !/OPR\//.test(ua);
      if(isChrome) document.documentElement.classList.add("is-chrome");
    })();
  </script>
</head>
<body>
  <section class="hero">
    <div class="center-wrap">

      <div class="brand" aria-label="BASE">
        <span class="fly" style="--i:0; --sx:64px;  --sy:8px;  --sc:1;">
          <img src="./assets/B.png" alt="B" />
        </span>
        <span class="fly" style="--i:1; --sx:22px;  --sy:0px;  --sc:1;">
          <img src="./assets/A.png" alt="A" />
        </span>
        <span class="fly" style="--i:2; --sx:-22px; --sy:0px;  --sc:1;">
          <img src="./assets/S.png" alt="S" />
        </span>
        <span class="fly" style="--i:3; --sx:-64px; --sy:0px;  --sc:1.07;">
          <img src="./assets/E.png" alt="E" />
        </span>
      </div>

      <!-- GET STARTED CTA -->
      <a href="/app" class="cta">Get started</a>

    </div>
  </section>
</body>
</html>
